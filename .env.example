# Database
DATABASE_URL="postgresql://central:central@localhost:5432/central_da_manada?schema=public"
POSTGRES_USER="central"
POSTGRES_PASSWORD="central"
POSTGRES_DB="central_da_manada"
POSTGRES_PORT="5432"

# API
API_PORT="3333"
NODE_ENV="development"
FRONTEND_URL="http://localhost:3000"
FRONTEND_URLS="http://localhost:3000,http://localhost:3001"
JWT_ACCESS_SECRET="change-me-access-secret"
JWT_REFRESH_SECRET="change-me-refresh-secret"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN_DAYS="7"
REFRESH_TOKEN_COOKIE_NAME="central_refresh_token"

# Initial admin seed
ADMIN_NAME="Coordenação"
ADMIN_EMAIL="admin@rotadocerrado.local"
ADMIN_PASSWORD="change-me-admin-password"

# Web
NEXT_PUBLIC_API_URL="http://localhost:3333/api"

# Redis
REDIS_HOST="localhost"
REDIS_PORT="6379"

# Read Replicas
DATABASE_READ_URL=""
