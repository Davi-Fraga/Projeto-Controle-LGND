# ============================================================================
# .env.production.example — Central da Manada (VPS)
# Copie para .env.production na VPS e preencha com valores REAIS e fortes.
# .env.production está no .gitignore — NUNCA versione segredos.
#
# Gere segredos fortes com:  openssl rand -base64 48
# ============================================================================

# ---- Domínio (usado pelo Caddy p/ emitir HTTPS e rotear) -------------------
# Preencha quando o domínio estiver registrado e o DNS apontando para a VPS.
DOMAIN=seudominio.com.br
API_DOMAIN=api.seudominio.com.br

# ---- Banco de dados (Postgres roda no compose, rede interna) ---------------
POSTGRES_USER=central
POSTGRES_PASSWORD=TROQUE_por_senha_forte
POSTGRES_DB=central_da_manada
# Host = nome do serviço no compose (postgres), porta interna 5432
DATABASE_URL=postgresql://central:TROQUE_por_senha_forte@postgres:5432/central_da_manada?schema=public
# Réplica de leitura: em VPS única, aponta para o mesmo banco
DATABASE_READ_URL=postgresql://central:TROQUE_por_senha_forte@postgres:5432/central_da_manada?schema=public

# ---- API -------------------------------------------------------------------
API_PORT=3333
NODE_ENV=production
# Origens permitidas no CORS — precisam bater com o domínio final (HTTPS)
FRONTEND_URL=https://seudominio.com.br
FRONTEND_URLS=https://seudominio.com.br

# JWT — gere valores novos e fortes (NÃO reuse os de dev)
JWT_ACCESS_SECRET=TROQUE_openssl_rand_base64_48
JWT_REFRESH_SECRET=TROQUE_openssl_rand_base64_48
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN_DAYS=7
REFRESH_TOKEN_COOKIE_NAME=central_refresh_token

# ---- Admin inicial (usado SÓ no seed manual, uma vez) ----------------------
ADMIN_NAME=Administrador
ADMIN_EMAIL=admin@seudominio.com.br
ADMIN_PASSWORD=TROQUE_senha_admin_forte

# ---- Frontend (build-time) -------------------------------------------------
# A API tem prefixo global /api -> inclua /api no final
NEXT_PUBLIC_API_URL=https://api.seudominio.com.br/api

# ---- Redis (roda no compose, rede interna) ---------------------------------
REDIS_HOST=redis
REDIS_PORT=6379

# ---- Webhook Google Forms (pré-inscrições) ---------------------------------
# Valor FORTE e NOVO (diferente do dev). É este mesmo valor que vai no Apps Script.
FORMS_WEBHOOK_SECRET=TROQUE_segredo_forte_do_webhook
